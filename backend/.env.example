# Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Security & JWT Secrets (Change in production)
JWT_ACCESS_SECRET=super_secret_jwt_access_key_ai_movie_matcher_2026_dev
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_ai_movie_matcher_2026_dev
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai-movie-matcher

# Redis (Cache & Queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# TMDB API (The Movie Database) - Must remain server-side only
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_v4_here
TMDB_API_KEY=your_tmdb_api_key_v3_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# AI Platform Integration (Shared Platform for LLM, Embeddings, RAG & Memory)
AI_PLATFORM_URL=http://localhost:5000
AI_PLATFORM_API_KEY=platform_master_key_dev_12345
AI_PLATFORM_TIMEOUT_MS=60000
APPLICATION_ID=ai-movie-matcher

# Notification Service Integration (Shared Service for Email & Push)
NOTIFICATION_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_API_KEY=notification_service_api_key_12345

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_AI_LIMIT=20
THROTTLE_AUTH_LIMIT=10
